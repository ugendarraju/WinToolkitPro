<ui:FluentWindow x:Class="WinToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:WinToolkit.ViewModels"
        xmlns:views="clr-namespace:WinToolkit.Views"
        xmlns:models="clr-namespace:WinToolkit.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WinToolkit Pro" Height="720" Width="1120"
        MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Icon="Assets/app.ico">

    <Window.Resources>
        <!-- Sidebar Navigation Item Style -->
        <Style x:Key="SidebarNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Blue accent vertical indicator pill -->
                                <Border x:Name="Indicator" Grid.Column="0" Width="3.5" Height="18" 
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" 
                                        CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed" Margin="-8,0,10,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hidden Header TabControl for content switching -->
        <Style x:Key="PagePresenterTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent Window TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="WinToolkit Pro" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>

        <!-- Main Work Area with Vertical Sidebar Navigation -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" MinWidth="200" MaxWidth="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Left Navigation Sidebar Rail ================= -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Branding Header -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="6" ClipToBounds="True" Width="26" Height="26" Margin="0,0,8,0">
                                <Image Source="Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="WinToolkit Pro" FontWeight="Bold" FontSize="16" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="34,2,0,0"/>
                        <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="4" 
                                Padding="6,2" Margin="34,4,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding OsEnv.OsDisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="#60a5fa"/>
                        </Border>

                        <!-- GitHub Update Notification Banner -->
                        <Border Background="#064e3b" BorderBrush="#10b981" BorderThickness="1" CornerRadius="6" 
                                Padding="8,6" Margin="0,10,0,0"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="🚀 Update Ready!" FontWeight="Bold" FontSize="11" Foreground="#ecfdf5"/>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="10" Foreground="#a7f3d0" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="4" Margin="0,0,0,6"
                                             Visibility="{Binding IsUpdatingApp, Converter={StaticResource BoolToVis}}"
                                             Foreground="#34d399"/>
                                <Button Content="⚡ Install &amp; Restart" Command="{Binding ApplyAppUpdateCommand}"
                                        IsEnabled="{Binding CanApplyUpdate}"
                                        Background="#10b981" Foreground="White" FontWeight="Bold" 
                                        FontSize="10" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox SelectedIndex="{Binding SelectedNavigationIndex}"
                                 ItemContainerStyle="{StaticResource SidebarNavItemStyle}"
                                 Background="Transparent" BorderThickness="0">
                            <!-- Item 0: Software Catalog -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Software Installer"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 1: App Updater -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="App Updater"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 2: OS Optimizer -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="OS Optimizer"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 3: Hardware & Drivers -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚗" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Hardware and Drivers installer"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 4: Windows Update -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Windows Update"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 5: System Cleaner -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧹" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="System Cleaner"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 6: System Tools (Repair, Debloat, Startup, Disk, Features) -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="System Tools"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Item 7: Activation -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔑" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Activation"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Sidebar Footer (System Status, Elevate & Theme) -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,10,0,0" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- System Details Badge -->
                            <Border Background="#1f2d3d" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SystemInfo}" FontSize="10" Foreground="#38bdf8" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Activity Drawer Toggle -->
                            <Button Content="📊 Active Tasks / Log" Command="{Binding Activity.ToggleDrawerCommand}" 
                                    Background="#1e293b" Foreground="#38bdf8" FontWeight="SemiBold"
                                    Padding="8,5" FontSize="11" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                            <!-- Elevate to Admin (only visible when not elevated) -->
                            <Button Content="🛡️ Elevate to Admin" Command="{Binding RestartAsAdminCommand}" 
                                    Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}"
                                    Background="#991b1b" Foreground="White" FontWeight="SemiBold"
                                    Padding="8,5" FontSize="11" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                            <!-- Theme Toggle -->
                            <Button Content="🌓 Toggle Theme" Command="{Binding ToggleThemeCommand}" 
                                    Padding="8,5" FontSize="11" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= Right Content Workspace Area ================= -->
            <Grid Grid.Column="1">
                <TabControl Style="{StaticResource PagePresenterTabControl}"
                            SelectedIndex="{Binding SelectedNavigationIndex}">
                    <!-- Page 0: Software Installer -->
                    <TabItem>
                        <views:AppsView DataContext="{Binding AppsVM}"/>
                    </TabItem>

                    <!-- Page 1: App Updater -->
                    <TabItem>
                        <views:AppUpdaterView DataContext="{Binding AppUpdaterVM}"/>
                    </TabItem>

                    <!-- Page 2: OS Optimizer -->
                    <TabItem>
                        <views:OptimizerView DataContext="{Binding OptimizerVM}"/>
                    </TabItem>

                    <!-- Page 3: Drivers & Hardware Specs -->
                    <TabItem>
                        <views:DriversView DataContext="{Binding DriversVM}"/>
                    </TabItem>

                    <!-- Page 4: Windows Update -->
                    <TabItem>
                        <views:WindowsUpdateView DataContext="{Binding WindowsUpdateVM}"/>
                    </TabItem>

                    <!-- Page 5: System Cleaner -->
                    <TabItem>
                        <views:CleanerView DataContext="{Binding CleanerVM}"/>
                    </TabItem>

                    <!-- Page 6: System Tools (Repair, Debloater, Startup, Disk, Features) -->
                    <TabItem>
                        <views:SystemToolsView DataContext="{Binding SystemToolsVM}"/>
                    </TabItem>

                    <!-- Page 7: Activation -->
                    <TabItem>
                        <views:ActivationView DataContext="{Binding ActivationVM}"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ================= Right Activity / Status Drawer (Ninite-style) ================= -->
            <Border Grid.Column="2" Width="330"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding Activity.IsOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Activity.CurrentOperation}" FontWeight="Bold" FontSize="13" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Clear Finished Tasks Button -->
                        <Button Grid.Column="1" Content="Clear Finished" 
                                Command="{Binding Activity.ClearFinishedCommand}"
                                Padding="8,3" FontSize="10" Margin="0,0,6,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" Cursor="Hand"/>

                        <Button Grid.Column="2" Content="✕" 
                                Command="{Binding Activity.CloseDrawerCommand}"
                                Padding="6,2" FontSize="12" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" Cursor="Hand"/>
                    </Grid>

                    <!-- Overall Progress & Status -->
                    <Border Grid.Row="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="{Binding Activity.StatusText}" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Activity.OverallProgress, StringFormat={}{0:0}%}" 
                                           HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                            </Grid>
                            <ProgressBar Value="{Binding Activity.OverallProgress}" Maximum="100" Height="5" 
                                         Foreground="#38bdf8" Background="#1e293b" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Task Cards List (Ninite Style) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State Notice if no active tasks -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,6"
                                    Visibility="{Binding Activity.ActiveTasks.Count, Converter={StaticResource ZeroToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="No active tasks in progress." FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Trigger an action from any tab (Software Installer, Debloater, Optimizer, Cleaner, etc.) to track live progress here." 
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Items list -->
                            <ItemsControl ItemsSource="{Binding Activity.ActiveTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: App Name, Category Badge, Status Pill, and Dismiss Button -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" 
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <!-- Category Badge -->
                                                    <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                            CornerRadius="3" Padding="5,1" Margin="6,0,6,0" VerticalAlignment="Center"
                                                            Visibility="{Binding Category, Converter={StaticResource StringNotEmptyToVis}}">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </Border>

                                                    <!-- Status Badge Pill -->
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#334155"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Queued}">
                                                                        <Setter Property="Background" Value="#334155"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Running}">
                                                                        <Setter Property="Background" Value="#1e3a8a"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Completed}">
                                                                        <Setter Property="Background" Value="#14532d"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Failed}">
                                                                        <Setter Property="Background" Value="#7f1d1d"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Queued}">
                                                                            <Setter Property="Foreground" Value="#cbd5e1"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Running}">
                                                                            <Setter Property="Foreground" Value="#60a5fa"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Completed}">
                                                                            <Setter Property="Foreground" Value="#4ade80"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Failed}">
                                                                            <Setter Property="Foreground" Value="#f87171"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Dismiss Task Button -->
                                                    <Button Grid.Column="3" Content="✕" 
                                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Activity.RemoveTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,1" Margin="4,0,0,0" FontSize="10" Background="Transparent" BorderThickness="0"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" Cursor="Hand" ToolTip="Dismiss"/>
                                                </Grid>

                                                <!-- Row 1: Status Message description -->
                                                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="10.5" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           Margin="0,3,0,4" TextTrimming="CharacterEllipsis"/>

                                                <!-- Row 2: Micro Progress Bar -->
                                                <ProgressBar Grid.Row="2" Height="3" BorderThickness="0" Background="#1e293b"
                                                             Foreground="#38bdf8" Value="{Binding Progress}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="IsIndeterminate" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Running}">
                                                                    <Setter Property="IsIndeterminate" Value="True"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Completed}">
                                                                    <Setter Property="Value" Value="100"/>
                                                                    <Setter Property="Foreground" Value="#22c55e"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ActivityTaskStatus.Failed}">
                                                                    <Setter Property="Value" Value="100"/>
                                                                    <Setter Property="Foreground" Value="#ef4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Expander: Raw Console Log -->
                    <Expander Grid.Row="3" Header="Detailed Console Logs" IsExpanded="False" 
                              Margin="0,8,0,0" Padding="0">
                        <Border Background="#090d16" CornerRadius="4" Padding="6" Height="150">
                            <ListBox ItemsSource="{Binding Activity.Logs}" 
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="10" Foreground="#38bdf8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="MinHeight" Value="14"/>
                                        <Setter Property="Foreground" Value="#38bdf8"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
