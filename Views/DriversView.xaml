<UserControl x:Class="WinToolkit.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Hardware &amp; Driver Manager" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Detect hardware devices, query certified Microsoft driver updates online, and install them automatically." 
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍 Scan Hardware" Command="{Binding ScanHardwareCommand}" 
                        Margin="0,0,8,0" Padding="14,6"/>

                <Button Content="🌐 Check Online Drivers" Command="{Binding CheckOnlineUpdatesCommand}" 
                        Margin="0,0,8,0" Padding="14,6"/>
                
                <Button Content="⚡ Install Driver Updates" 
                        Command="{Binding InstallDriverUpdatesCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="SemiBold"
                        Padding="16,7"/>
            </StackPanel>
        </Grid>

        <!-- Status & Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Medium" 
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsScanning}" Width="150" Height="6"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
            </Grid>
        </Border>

        <!-- Two Tabs / Split for Updates & Hardware -->
        <TabControl Grid.Row="2" Margin="0,0,0,12">
            <!-- Online Driver Updates Tab -->
            <TabItem Header="Online Driver Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Notice if no updates -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💡 Click 'Check Online Drivers' to scan Microsoft's certified catalog for updates." 
                                           HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PendingUpdates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Manufacturer, StringFormat='Provider: {0}'}" FontSize="12" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding HardwareId, StringFormat='ID: {0}'}" FontSize="11" 
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#1a3d24" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#4ade80" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hardware Inventory Tab -->
            <TabItem Header="Detected Hardware Devices">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="13" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding HardwareId}" FontSize="10" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                CornerRadius="4" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceClass}" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Live Output Terminal -->
        <Border Grid.Row="3" Background="#111116" BorderBrush="#33333e" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Hardware &amp; Driver Diagnostics Log" FontSize="11" FontWeight="SemiBold" Foreground="#888899" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" 
                         Background="Transparent" BorderThickness="0" 
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#c0caf5"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
