<UserControl x:Class="WinToolkit.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Segmented Navigation Pill Style for SubTabs -->
        <Style x:Key="SegmentedPillTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="PillBorder" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,8" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hardware Specifications &amp; Driver Center" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="4" 
                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DriverArchNotice}" FontSize="10" FontWeight="SemiBold" Foreground="#60a5fa"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Hardware components dashboard, laptop battery health reports, and certified driver update servicing." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Main Content SubTabs styled as Segmented Navigation Pills -->
        <TabControl Grid.Row="1" Margin="0,0,0,8" ItemContainerStyle="{StaticResource SegmentedPillTabItem}">
            <!-- SubTab 1: System Specs & Battery Health -->
            <TabItem Header="📊 System Specs &amp; Battery Health">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
                        <!-- Toolbar -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Detected Hardware Configuration" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Refresh Specs" Command="{Binding LoadSystemSpecsCommand}" Padding="12,5" FontSize="11" Margin="0,0,8,0"/>
                                    <Button Command="{Binding GenerateBatteryReportCommand}" 
                                            Visibility="{Binding Hardware.HasBattery, Converter={StaticResource BoolToVis}}"
                                            Background="#0284c7" Foreground="White" FontWeight="SemiBold" Padding="12,5" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 "/>
                                            <TextBlock Text="Open Full Battery Report (HTML)"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hardware Spec Cards Grid -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- CPU Card -->
                            <Border Width="330" Margin="0,0,12,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="⚡ " FontSize="16"/>
                                        <TextBlock Text="Processor (CPU)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.CpuName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Cores / Threads: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.CpuCores}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text=" Cores, " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.CpuThreads}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text=" Threads" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Clock / Arch: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.CpuClockSpeed}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text=" (" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.CpuArchitecture}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- GPU Card -->
                            <Border Width="330" Margin="0,0,12,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🎮 " FontSize="16"/>
                                        <TextBlock Text="Graphics (GPU)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.GpuName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="VRAM: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.GpuVram}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Driver Version: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.GpuDriverVersion}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- RAM Card -->
                            <Border Width="330" Margin="0,0,12,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="💾 " FontSize="16"/>
                                        <TextBlock Text="Memory (RAM)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Hardware.RamTotal}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#1e293b" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Hardware.RamType, Converter={StaticResource StringNotEmptyToVis}}">
                                            <TextBlock Text="{Binding Hardware.RamType}" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Status: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.RamAvailable}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Speed / Modules: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.RamSpeed}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text=" - " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.RamSlots}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Motherboard Card -->
                            <Border Width="330" Margin="0,0,12,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🖥️ " FontSize="16"/>
                                        <TextBlock Text="Motherboard &amp; BIOS" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hardware.MotherboardModel}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Hardware.MotherboardManufacturer}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="BIOS Version: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.BiosVersion}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Battery Health Card (Only shown if laptop has battery) -->
                            <Border Width="330" Margin="0,0,12,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"
                                    Visibility="{Binding Hardware.HasBattery, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🔋 " FontSize="16"/>
                                        <TextBlock Text="Battery Health" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Charge: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.BatteryPercentage, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="13" Foreground="#10b981"/>
                                        <TextBlock Text=" | Health: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.BatteryHealthPercent, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="13" Foreground="#38bdf8"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Grade: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.BatteryHealthGrade}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Capacity: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.BatteryFullChargeCapacity}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Hardware.BatteryDesignCapacity}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Storage Drives Table -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Storage Disks &amp; Partitions" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Hardware.Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="6" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Model}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    
                                                    <!-- Capacity Bar -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                                        <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8"
                                                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FreeSize, StringFormat='{}{0} Free'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding TotalSize, StringFormat='{}of {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SubTab 2: Drivers & Windows Update Catalog -->
            <TabItem Header="🚗 Hardware Drivers &amp; Updates">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Driver Actions Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Driver Source Selection & Snappy GUI -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="340"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Driver Source:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DriverSources}" SelectedItem="{Binding SelectedDriverSource}" FontSize="11" Padding="8,4" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Visibility="{Binding SelectedDriverCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding SelectedDriverCount, StringFormat='{}Selected: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8"/>
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Content="📱 Device Manager" Command="{Binding OpenDeviceManagerCommand}" 
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        FontWeight="SemiBold" Padding="12,5" FontSize="11"
                                        ToolTip="Open standard Windows Device Manager (devmgmt.msc)"/>
                            </Grid>

                            <!-- Row 1: Actions & Installation Buttons -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Select All" Command="{Binding SelectAllDriversCommand}" Margin="0,0,6,0" Padding="10,5" FontSize="11"/>
                                    <Button Content="Clear All" Command="{Binding DeselectAllDriversCommand}" Margin="0,0,8,0" Padding="10,5" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔍 Scan Hardware" Command="{Binding ScanHardwareCommand}" Margin="0,0,6,0" Padding="12,5" FontSize="11"/>
                                    <Button Content="🌐 Check Updates" Command="{Binding CheckOnlineUpdatesCommand}" Margin="0,0,6,0" Padding="12,5" FontSize="11"/>
                                    <Button Content="{Binding SelectedDriverCount, StringFormat='⚡ Install Selected Drivers ({0})'}" 
                                            Command="{Binding InstallDriverUpdatesCommand}"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                            FontWeight="SemiBold" Padding="14,5" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Summary Banner -->
                    <Border Grid.Row="1" Margin="0,0,0,8" 
                            Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"
                            Background="#1e3a5f" BorderBrush="#0284c7" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding SummaryMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#38bdf8"/>
                    </Border>

                    <!-- Device List with Checkboxes -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CheckBox to select the required driver -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <TextBlock Grid.Column="1" Text="🚗 " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceClass}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Manufacturer: " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Manufacturer}" FontSize="10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Installed: " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding CurrentDriverVersion}" FontSize="10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Update: " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding AvailableDriverVersion, Converter={StaticResource StringNotEmptyToVis}}"/>
                                                        <TextBlock Text="{Binding AvailableDriverVersion}" FontSize="10" Foreground="#38bdf8" FontWeight="SemiBold" Margin="0,0,10,0"
                                                                   Visibility="{Binding AvailableDriverVersion, Converter={StaticResource StringNotEmptyToVis}}"/>
                                                        <TextBlock Text="{Binding DriverDate, StringFormat='({0})'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{Binding DriverDate, Converter={StaticResource StringNotEmptyToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
