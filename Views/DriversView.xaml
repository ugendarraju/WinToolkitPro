<UserControl x:Class="WinToolkit.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Hardware &amp; Driver Manager" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Detect hardware devices, query certified Microsoft driver updates online, and install them automatically." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍 Scan Hardware" Command="{Binding ScanHardwareCommand}" 
                        Margin="0,0,6,0" Padding="12,5" FontSize="12"/>

                <Button Content="🌐 Check Online Drivers" Command="{Binding CheckOnlineUpdatesCommand}" 
                        Margin="0,0,6,0" Padding="12,5" FontSize="12"/>
                
                <Button Content="⚡ Install Driver Updates" 
                        Command="{Binding InstallDriverUpdatesCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="SemiBold"
                        Padding="16,6"
                        FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Status & Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsScanning}" Width="150" Height="5"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
            </Grid>
        </Border>

        <!-- Completion Summary Banner -->
        <Border Grid.Row="2" Margin="0,0,0,8" 
                Background="#064e3b" BorderBrush="#059669" BorderThickness="1" 
                CornerRadius="6" Padding="10,8"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SummaryMessage}" FontWeight="SemiBold" FontSize="13" Foreground="#ecfdf5" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔄 Check Again" Command="{Binding CheckOnlineUpdatesCommand}" 
                        Padding="10,3" FontSize="11" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Two Tabs / Split for Updates & Hardware -->
        <TabControl Grid.Row="3" Margin="0,0,0,8">
            <!-- Online Driver Updates Tab -->
            <TabItem Header="Online Driver Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Instructions card -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <TextBlock Text="💡 Click 'Check Online Drivers' to scan Microsoft's certified catalog. Administrator privileges are required to install driver packages." 
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PendingUpdates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" 
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Row="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <!-- Driver details -->
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="13" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Manufacturer, StringFormat='Provider: {0}'}" FontSize="11" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                                                
                                                <!-- Dynamic live status text -->
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Dynamic Status Badge -->
                                            <Border Grid.Row="0" Grid.Column="2" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1e3a5f"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Background" Value="#16a34a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Background" Value="#dc2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Background" Value="#d97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Progress bar during download/install -->
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                                         Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                                         Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hardware Inventory Tab -->
            <TabItem Header="Detected Hardware Devices">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,5" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding HardwareId}" FontSize="10" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                CornerRadius="4" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceClass}" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Live Output Terminal -->
        <Border Grid.Row="4" Background="#111116" BorderBrush="#33333e" BorderThickness="1" CornerRadius="6" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Hardware &amp; Driver Diagnostics Log" FontSize="11" FontWeight="SemiBold" Foreground="#888899" Margin="2,0,0,2"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" 
                         Background="Transparent" BorderThickness="0" 
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#c0caf5"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
