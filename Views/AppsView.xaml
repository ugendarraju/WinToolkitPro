<UserControl x:Class="WinToolkit.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="1. Pick the apps you want" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Select softwares and click install to download and install them automatically without user input." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="12,5" FontSize="12"/>
                <Button Content="Clear" Command="{Binding DeselectAllCommand}" Margin="0,0,6,0" Padding="12,5" FontSize="12"/>
                <Button Content="🧹 Clean Temp" Command="{Binding CleanTempCacheCommand}" Margin="0,0,10,0" Padding="10,5" FontSize="12"/>
                
                <Button Command="{Binding InstallSelectedCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="Bold"
                        Padding="16,6"
                        FontSize="13"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ Install Selected " FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedCount, StringFormat='({0})'}" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Content="Cancel" Command="{Binding CancelInstallationCommand}" 
                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"
                        Padding="12,5" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalContentAlignment="Center"
                         Padding="8,5"
                         FontSize="12"
                         Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          Padding="8,5"
                          FontSize="12"/>
            </Grid>
        </Border>

        <!-- Software Catalog (Ninite Style) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding GroupedApps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="215" Margin="0,0,12,14" VerticalAlignment="Top"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,8">
                                <StackPanel>
                                    <!-- Category Title Header -->
                                    <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" 
                                            BorderThickness="0,0,0,2" Padding="0,0,0,5" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="13" 
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>

                                    <!-- Compact App Checkboxes List with MaxHeight ScrollViewer -->
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Apps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2" ToolTip="{Binding Description}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checkbox with Name -->
                                                        <CheckBox IsChecked="{Binding IsSelected}" 
                                                                  Content="{Binding Name}" 
                                                                  FontSize="12"
                                                                  VerticalAlignment="Center"/>

                                                        <!-- Status Badge (only shown during/after install) -->
                                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                CornerRadius="3" Padding="4,1"
                                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                Visibility="{Binding HasActiveStatus, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding StatusMessage}" FontSize="9" 
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Overall Progress Bar (Visible while installing) -->
        <ProgressBar Grid.Row="3" Value="{Binding OverallProgress}" Maximum="100" Height="5" 
                     Margin="0,0,0,6"
                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

        <!-- Live Output Log Terminal -->
        <Border Grid.Row="4" Background="#111116" BorderBrush="#33333e" BorderThickness="1" CornerRadius="6" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Installation Console Logs" FontSize="11" FontWeight="SemiBold" Foreground="#888899" Margin="2,0,0,2"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" 
                         Background="Transparent" BorderThickness="0" 
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#c0caf5"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
