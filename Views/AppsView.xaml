<UserControl x:Class="WinToolkit.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1150">

    <UserControl.Resources>
        <!-- Filter Chip Button Style -->
        <Style x:Key="AppCategoryChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Global Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="1. Pick the apps you want" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="4" 
                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ArchitectureNotice}" FontSize="10" FontWeight="SemiBold" Foreground="#60a5fa"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Segregated by software category. Select apps to download and silently install them in batch." 
                           FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Buttons WrapPanel ensuring controls never clip -->
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Command="{Binding InstallSelectedCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        BorderBrush="#38bdf8" BorderThickness="1"
                        FontWeight="Bold"
                        Padding="14,6"
                        FontSize="12"
                        Margin="0,0,6,4"
                       
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ Install Selected " FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedCount, StringFormat='({0})'}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Background="#1e293b" Foreground="#f8fafc" BorderBrush="#475569" BorderThickness="1"
                        FontWeight="SemiBold" Margin="0,0,5,4" Padding="11,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Clear All" Command="{Binding DeselectAllCommand}" 
                        Background="#1e293b" Foreground="#f8fafc" BorderBrush="#475569" BorderThickness="1"
                        FontWeight="SemiBold" Margin="0,0,5,4" Padding="11,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Expand All" Command="{Binding ExpandAllCommand}" 
                        Background="#1e293b" Foreground="#cbd5e1" BorderBrush="#334155" BorderThickness="1"
                        Margin="0,0,5,4" Padding="10,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Collapse All" Command="{Binding CollapseAllCommand}" 
                        Background="#1e293b" Foreground="#cbd5e1" BorderBrush="#334155" BorderThickness="1"
                        Margin="0,0,6,4" Padding="10,5" FontSize="11" Cursor="Hand"/>

                <Button Command="{Binding ToggleActivityPanelCommand}" 
                        Background="#0284c7" Foreground="White" BorderBrush="#38bdf8" BorderThickness="1.5"
                        FontWeight="Bold" Margin="0,0,6,4" Padding="12,5" FontSize="11" Cursor="Hand"
                        ToolTip="Toggle the active tasks and download progress panel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 " FontSize="11"/>
                        <TextBlock Text="Activity" FontWeight="Bold"/>
                        <TextBlock Text="{Binding OverallProgress, StringFormat=' ({0:0}%)'}" 
                                   Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" 
                                   FontWeight="Bold" Foreground="#fef08a"/>
                    </StackPanel>
                </Button>

                <!-- Clean Temp button highlighted with high-contrast warm amber badge styling -->
                <Button Command="{Binding CleanTempCacheCommand}" 
                        Background="#b45309" Foreground="White" BorderBrush="#f59e0b" BorderThickness="1"
                        FontWeight="Bold" Margin="0,0,5,4" Padding="12,5" FontSize="11" Cursor="Hand"
                        ToolTip="Purge cached installers and temporary download files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹 " FontSize="11"/>
                        <TextBlock Text="Clean Temp"/>
                    </StackPanel>
                </Button>
                
                <Button Content="Cancel" Command="{Binding CancelInstallationCommand}" 
                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"
                        Background="#dc2626" Foreground="White" BorderBrush="#f87171" BorderThickness="1"
                        FontWeight="Bold" Padding="12,5" FontSize="11" Margin="0,0,0,4" Cursor="Hand"/>
            </WrapPanel>
        </Grid>

        <!-- Search Bar & Category Navigation Chips -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <!-- Search Box Row -->
                <Grid Margin="0,0,0,8">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center"
                             Padding="10,5"
                             FontSize="12"
                             ToolTip="Type to filter applications across all categories by name, winget ID, or description"/>
                </Grid>

                <!-- Category Navigation Filter Chips -->
                <ItemsControl ItemsSource="{Binding FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AppCategoryChipButtonStyle}"
                                    Command="{Binding DataContext.SelectCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Background="#20ffffff" CornerRadius="8" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Segregated Software Catalog Section Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding GroupedApps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Section Card -->
                        <Border Margin="0,0,0,14" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8">
                            <StackPanel Orientation="Vertical">
                                <!-- Section Header Banner -->
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        CornerRadius="8,8,0,0" 
                                        Padding="12,8"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Chevron Toggle, Section Icon, Name, Count Badge, Description -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding ToggleExpandedCommand}" 
                                                        Background="Transparent" BorderThickness="0" 
                                                        Padding="4,2" Margin="0,0,6,0" Cursor="Hand"
                                                        ToolTip="Toggle Section Expand/Collapse">
                                                    <TextBlock Text="{Binding ChevronText}" FontSize="11" FontWeight="Bold" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Button>

                                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="14" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                                                <!-- Section Selection Status Badge -->
                                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectionBadgeText}" FontSize="10.5" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Section Description Subtitle -->
                                            <TextBlock Text="{Binding Description}" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       Margin="26,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Right: Section Quick Selection Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Select Section" 
                                                    Command="{Binding SelectSectionCommand}" 
                                                    Padding="8,3" FontSize="10.5" Margin="0,0,5,0"
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Cursor="Hand" ToolTip="Select all apps in this section"/>

                                            <Button Content="Clear" 
                                                    Command="{Binding ClearSectionCommand}" 
                                                    Padding="8,3" FontSize="10.5" Margin="0,0,5,0"
                                                    Background="Transparent" BorderThickness="1"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Cursor="Hand" ToolTip="Clear selections in this section"/>

                                            <Button Content="{Binding ExpandCollapseButtonText}" 
                                                    Command="{Binding ToggleExpandedCommand}" 
                                                    Padding="6,3" FontSize="10.5"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Apps Grid inside this Section with Generous Tile Width (No Truncation) -->
                                <ItemsControl ItemsSource="{Binding Apps}" 
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                              Margin="10,10,2,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- App Tile with 290px width ensuring full software names fit -->
                                            <Border Width="290" Margin="0,0,10,10" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="10,8">
                                                <Grid ToolTip="{Binding Description}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- CheckBox -->
                                                    <CheckBox IsChecked="{Binding IsSelected}" 
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0"/>

                                                    <!-- App Name and Description -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Status Badge (e.g. Installing, Installed, etc.) -->
                                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                                                            CornerRadius="4" Padding="6,2"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            Visibility="{Binding HasActiveStatus, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
