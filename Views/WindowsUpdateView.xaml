<UserControl x:Class="WinToolkit.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WindowsUpdateViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Windows &amp; Microsoft Update Manager" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Scan for missing Microsoft updates (Quality, Cumulative, Security, .NET), review details, and install them safely." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍 Scan Updates" Command="{Binding ScanUpdatesCommand}" 
                        Margin="0,0,6,0" Padding="12,5" FontSize="12"/>

                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Margin="0,0,6,0" Padding="10,5" FontSize="12"/>

                <Button Content="Clear All" Command="{Binding DeselectAllCommand}" 
                        Margin="0,0,8,0" Padding="10,5" FontSize="12"/>

                <Button Content="⚡ Install Selected Updates" 
                        Command="{Binding InstallSelectedUpdatesCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="SemiBold"
                        Padding="16,6"
                        FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Status & Filter Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Medium" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0"
                            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Selected: "/>
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Run Text=" | Size: "/>
                            <Run Text="{Binding TotalSelectedSizeMB, Mode=OneWay, StringFormat='{}{0:F1} MB'}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsScanning}" Width="150" Height="5" Margin="0,0,12,0"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                <!-- Search box -->
                <TextBox Grid.Column="2" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Padding="8,4" FontSize="11"
                         Tag="Filter updates by KB, title, category..."/>
            </Grid>
        </Border>

        <!-- Completion / Restart Banner -->
        <Border Grid.Row="2" Margin="0,0,0,8" 
                BorderThickness="1" CornerRadius="6" Padding="12,8"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#064e3b"/>
                    <Setter Property="BorderBrush" Value="#059669"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RebootRequired}" Value="True">
                            <Setter Property="Background" Value="#78350f"/>
                            <Setter Property="BorderBrush" Value="#d97706"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SummaryMessage}" FontWeight="SemiBold" FontSize="13" Foreground="#ffffff" VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Content="🔄 Check Again" Command="{Binding ScanUpdatesCommand}" 
                        Padding="10,4" FontSize="11" Margin="8,0,4,0"/>

                <Button Grid.Column="2" Content="⚠️ Restart PC Now" Command="{Binding RebootComputerCommand}"
                        Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}"
                        Background="#dc2626" Foreground="White" FontWeight="Bold"
                        Padding="12,4" FontSize="11" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Updates List Section -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <Grid>
                <!-- Empty State Prompt -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Visibility="{Binding FilteredUpdates.Count, Converter={StaticResource ZeroToVis}}">
                    <TextBlock Text="🔄 Click 'Scan Updates' above to search Microsoft Update servers." 
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Supports Windows 10/11 Cumulative Updates, Security KBs, .NET Framework / Runtime patches, and servicing stack updates." 
                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- Update Items ScrollViewer -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredUpdates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" 
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Select Checkbox -->
                                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Update Details -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Metadata badges & description -->
                                            <WrapPanel Margin="0,3,0,0">
                                                <!-- KB Article Tag -->
                                                <Border Background="#1e293b" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                                        Visibility="{Binding KBArticle, Converter={StaticResource StringNotEmptyToVis}}">
                                                    <TextBlock Text="{Binding KBArticle}" FontSize="11" Foreground="#38bdf8" FontWeight="Medium"/>
                                                </Border>

                                                <!-- Category Badge -->
                                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>

                                                <!-- Size Tag -->
                                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>

                                                <!-- Severity Tag -->
                                                <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1f2937"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Background" Value="#7f1d1d"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Important">
                                                                    <Setter Property="Background" Value="#78350f"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="#f3f4f6" FontWeight="Medium"/>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Live status message -->
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                       Margin="0,3,0,0"/>

                                            <!-- Optional failure error message -->
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#ef4444" 
                                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Row="0" Grid.Column="2" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1e3a5f"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                            <Setter Property="Background" Value="#16a34a"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Background" Value="#dc2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Background" Value="#d97706"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                                     Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Live Diagnostics Log Terminal -->
        <Border Grid.Row="4" Background="#111116" BorderBrush="#33333e" BorderThickness="1" CornerRadius="6" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Microsoft Update Diagnostics &amp; Installation Log" FontSize="11" FontWeight="SemiBold" Foreground="#888899" Margin="2,0,0,2"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" 
                         Background="Transparent" BorderThickness="0" 
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#c0caf5"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
