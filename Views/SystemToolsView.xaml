<UserControl x:Class="WinToolkit.Views.SystemToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemToolsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1150">
    <UserControl.Resources>
        <!-- Segmented Navigation Pill Style for SubTabs -->
        <Style x:Key="SegmentedPillTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="PillBorder" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,8" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🛠️ System Repair &amp; Maintenance Tools" FontSize="22" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Integrated utilities for Windows system file repairs, DNS optimization, debloating, startup management, storage analysis, and optional features." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Sub Tabs styled as Segmented Navigation Pills -->
        <TabControl Grid.Row="1" Margin="0,0,0,8" ItemContainerStyle="{StaticResource SegmentedPillTabItem}">
            <!-- Sub Tab 1: System Health & Network -->
            <TabItem Header="🩺 System Health &amp; Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel MaxWidth="950" HorizontalAlignment="Left">
                        <!-- Card 1: Windows Integrity & OS Repair -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Windows Component Store &amp; System File Repair" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Execute automated Windows image servicing and system integrity scans to fix crashes, corrupted DLLs, and bloated update caches." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Command="{Binding RunSfcCommand}" IsEnabled="{Binding IsBusy, Converter={x:Null}}" Margin="0,0,10,10" Padding="14,8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🩺 " FontSize="13"/>
                                            <TextBlock Text="SFC Scannow (System File Checker)" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RunDismRestoreHealthCommand}" Margin="0,0,10,10" Padding="14,8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛡️ " FontSize="13"/>
                                            <TextBlock Text="DISM RestoreHealth (Repair Image)" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RunDismCleanupCommand}" Margin="0,0,10,10" Padding="14,8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🧹 " FontSize="13"/>
                                            <TextBlock Text="WinSxS Component Store Deep Cleanup" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding CreateRestorePointCommand}" Margin="0,0,10,10" Padding="14,8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " FontSize="13"/>
                                            <TextBlock Text="Create System Restore Point" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Active Execution Indicator Banner -->
                                <Border Background="#1e293b" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="6" Padding="12,8"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⏳ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" FontSize="12" Foreground="#38bdf8"/>
                                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,12,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="⏹️ Stop Operation" Command="{Binding CancelOperationCommand}" 
                                                Background="#dc2626" Foreground="White" FontWeight="SemiBold" Padding="10,4" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Network & Fast DNS Switcher -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Network Stack &amp; Fast DNS Resolver Switcher" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Flush DNS resolver caches, reset corrupted sockets, and switch to high-performance privacy or ad-blocking DNS servers in one click." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Command="{Binding FlushNetworkCommand}" Padding="14,7" Margin="0,0,10,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄 " FontSize="12"/>
                                            <TextBlock Text="Flush DNS &amp; Reset Winsock" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="Select Fast DNS Preset:" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,8"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding SetDnsCommand}" CommandParameter="Cloudflare" Margin="0,0,8,8" Padding="12,6">
                                        <TextBlock Text="⚡ Cloudflare (1.1.1.1 - Fastest Latency)" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding SetDnsCommand}" CommandParameter="Google" Margin="0,0,8,8" Padding="12,6">
                                        <TextBlock Text="🔍 Google (8.8.8.8 - High Reliability)" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding SetDnsCommand}" CommandParameter="AdGuard" Margin="0,0,8,8" Padding="12,6">
                                        <TextBlock Text="🛡️ AdGuard (Blocks Ads &amp; Trackers)" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding SetDnsCommand}" CommandParameter="Quad9" Margin="0,0,8,8" Padding="12,6">
                                        <TextBlock Text="🔒 Quad9 (Malware &amp; Phishing Guard)" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding SetDnsCommand}" CommandParameter="DHCP" Margin="0,0,8,8" Padding="12,6">
                                        <TextBlock Text="🔄 Automatic (Reset to ISP DHCP)" FontSize="11"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sub Tab 2: Windows Bloatware Debloater -->
            <TabItem Header="🗑️ Bloatware Debloater">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Debloat Toolbar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="Show Bloatware Only (Recommended)" 
                                      IsChecked="{Binding ShowBloatwareOnly}" 
                                      FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" Padding="8,5" FontSize="11" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔍 Rescan" Command="{Binding ScanAppsCommand}" Margin="0,0,6,0" Padding="10,5" FontSize="11"/>
                                <Button Content="⚡ Select Safe Debloat" Command="{Binding SelectSafeDebloatCommand}" Margin="0,0,6,0" Padding="10,5" FontSize="11" FontWeight="SemiBold"/>
                                <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="10,5" FontSize="11"/>
                                <Button Content="Clear" Command="{Binding DeselectAllCommand}" Margin="0,0,8,0" Padding="10,5" FontSize="11"/>
                            </StackPanel>

                            <Button Grid.Column="3" Command="{Binding UninstallSelectedCommand}"
                                    Background="#dc2626" Foreground="White"
                                    FontWeight="Bold" Padding="16,6" FontSize="12" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️ Debloat Selected " FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedAppCount, StringFormat='({0})'}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Apps List -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="6">
                        <Grid>
                            <!-- Scanning Progress Overlay -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,50"
                                        Visibility="{Binding IsScanningApps, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="240" Height="4" Margin="0,0,0,12" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Scanning installed Windows packages and bloatware..." HorizontalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" CornerRadius="6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" 
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            
                                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                                    CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </Border>

                                                            <TextBlock Text="{Binding Name}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description}" FontSize="11" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#991b1b" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                                                Visibility="{Binding IsBloatware, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Safe to Remove" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8,3">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="🎉 No bloatware packages detected! Your Windows installation is already clean." 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40" 
                                       FontSize="14" Foreground="#10b981" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FilteredApps.Count}" Value="0"/>
                                                    <Condition Binding="{Binding IsScanningApps}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sub Tab 3: Startup & Services Manager -->
            <TabItem Header="🚀 Startup &amp; Services">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Startup Applications -->
                    <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Startup Applications" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Programs configured to launch automatically when Windows boots." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Command="{Binding LoadStartupAppsCommand}" 
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                        BorderBrush="#38bdf8" BorderThickness="1"
                                        FontWeight="Bold" Padding="14,6" FontSize="11" Cursor="Hand"
                                        ToolTip="Scan for startup programs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " FontSize="12"/>
                                        <TextBlock Text="Scan Startup Apps"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StartupApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="4" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding Command}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Location, StringFormat='Location: {0}'}" FontSize="9" Foreground="#38bdf8"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding DataContext.RemoveStartupAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Background="#dc2626" Foreground="White" BorderBrush="#f87171" BorderThickness="1"
                                                            FontWeight="Bold" FontSize="11" Padding="12,5" Cursor="Hand" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🗑️ " FontSize="11"/>
                                                            <TextBlock Text="Remove"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right Column: Background Services -->
                    <Border Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Background Services" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Inspect and toggle state of system and third-party services." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Command="{Binding LoadServicesCommand}" 
                                        Background="#0284c7" Foreground="White"
                                        BorderBrush="#38bdf8" BorderThickness="1"
                                        FontWeight="Bold" Padding="14,6" FontSize="11" Cursor="Hand"
                                        ToolTip="Enumerate and inspect Windows background services">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="12"/>
                                        <TextBlock Text="Load Services"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ServicesList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="4" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"/>
                                                            <TextBlock Text=" - Startup: " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding StartupType}" FontSize="10" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding DataContext.ToggleServiceStateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" FontWeight="Bold" FontSize="11" Padding="12,5" Cursor="Hand" VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#064e3b"/>
                                                                <Setter Property="BorderBrush" Value="#10b981"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Foreground" Value="#6ee7b7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Background" Value="#450a0a"/>
                                                                        <Setter Property="BorderBrush" Value="#ef4444"/>
                                                                        <Setter Property="Foreground" Value="#fca5a5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding ToggleButtonText}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sub Tab 4: SpaceSniffer Disk Treemap Visualizer -->
            <TabItem Header="🗺️ SpaceSniffer Treemap Analyzer">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drive Selector & Top Toolbar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Target Drive: " VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                            
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive}" VerticalAlignment="Center"/>

                            <ProgressBar Grid.Column="2" IsIndeterminate="{Binding IsDiskScanning}" Height="6" Margin="16,0"
                                         Visibility="{Binding IsDiskScanning, Converter={StaticResource BoolToVis}}"/>

                            <!-- Actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔍 Scan Visual Treemap" Command="{Binding AnalyzeDiskSpaceCommand}"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                        FontWeight="SemiBold" Padding="12,6" FontSize="12" Margin="0,0,8,0"/>

                                <Button Command="{Binding ToggleViewCommand}"
                                        Padding="10,6" FontSize="11" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 "/>
                                        <TextBlock Text="Switch View"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding LaunchSpaceSnifferCommand}"
                                        Background="#0284c7" Foreground="White" FontWeight="Bold" Padding="12,6" FontSize="12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀 "/>
                                        <TextBlock Text="Launch SpaceSniffer App"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Breadcrumbs & Path Navigator Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="⬆️ Up Folder" Command="{Binding NavigateUpCommand}"
                                    IsEnabled="{Binding CanNavigateUp}" Padding="8,3" FontSize="11" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Viewing Path: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentDiskPath}" FontWeight="Bold" FontSize="12" Foreground="#38bdf8" Margin="4,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="💡 Tip: Click any folder block to drill down; click 'Open' to view in Explorer."/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Visual Workspace: Treemap & List Views -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <!-- Treemap Interactive Blocks View -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsTreemapView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding DiskFolders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.DrillDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4" Padding="0" BorderThickness="1" BorderBrush="#334155"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{Binding ColorHex}"/>
                                                        <!-- Adaptive block size based on disk consumption -->
                                                        <Setter Property="Width" Value="240"/>
                                                        <Setter Property="Height" Value="110"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Percentage, Converter={x:Null}}" Value="null">
                                                                <Setter Property="Width" Value="240"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.88"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Header: Icon & Name -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        
                                                        <!-- Open button -->
                                                        <Button Grid.Column="2" Content="↗️" 
                                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Path}"
                                                                Background="#0f172a" Foreground="White" Padding="4,1" FontSize="10" 
                                                                ToolTip="Open in File Explorer"/>
                                                    </Grid>

                                                    <!-- Center: Percentage & Size Callout -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4">
                                                        <TextBlock Text="{Binding FormattedSize}" FontWeight="ExtraBold" FontSize="18" Foreground="#ffffff"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Footer: Visual Bar indicator -->
                                                    <ProgressBar Grid.Row="2" Value="{Binding Percentage}" Maximum="100" Height="4"
                                                                 Background="#1e293b" Foreground="#38bdf8"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Classic List View (Alternative Toggle) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTreemapView}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding DiskFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    CornerRadius="4" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                                               VerticalAlignment="Center" FontSize="14"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Percentage Usage Bar -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="8"
                                                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" 
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                    <Button Grid.Column="4" Content="📂 Open" Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Path}" FontSize="10" Padding="8,4" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sub Tab 5: Windows Optional Features -->
            <TabItem Header="🧩 Optional Features">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enable or disable core Windows hypervisors, WSL 2, sandbox, and legacy network components in one click."
                                       FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Button Grid.Column="1" Content="🔄 Refresh Features" Command="{Binding LoadOptionalFeaturesCommand}" Padding="10,4" FontSize="11"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OptionalFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                CornerRadius="4" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13"/>
                                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                                            Background="{Binding StateBadgeColor}">
                                                        <TextBlock Text="{Binding State}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <Button Command="{Binding DataContext.ToggleOptionalFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" FontSize="11" Padding="10,5">
                                                        <TextBlock Text="{Binding ToggleButtonText}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status & Progress Row -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelOperationCommand}" 
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Padding="10,4" FontSize="11"/>
        </Grid>
    </Grid>
</UserControl>
