<UserControl x:Class="WinToolkit.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CleanerViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="System &amp; Cache Cleaner" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Deep clean Windows junk, temporary files, browser caches, crash dumps, and application caches to reclaim storage space." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍 Analyze Junk" Command="{Binding AnalyzeCommand}" 
                        Background="#0284c7" Foreground="White" BorderBrush="#38bdf8" BorderThickness="1"
                        FontWeight="Bold" Margin="0,0,6,0" Padding="14,6" FontSize="12" Cursor="Hand"/>

                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Background="#1e293b" Foreground="#f8fafc" BorderBrush="#475569" BorderThickness="1"
                        FontWeight="SemiBold" Margin="0,0,6,0" Padding="11,5" FontSize="12" Cursor="Hand"/>

                <Button Content="Clear All" Command="{Binding DeselectAllCommand}" 
                        Background="#1e293b" Foreground="#f8fafc" BorderBrush="#475569" BorderThickness="1"
                        FontWeight="SemiBold" Margin="0,0,8,0" Padding="11,5" FontSize="12" Cursor="Hand"/>

                <Button Content="🧹 Clean Selected Files" 
                        Command="{Binding CleanCommand}"
                        Background="#059669"
                        Foreground="White"
                        BorderBrush="#34d399"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Padding="16,6"
                        FontSize="13"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Status & Metrics Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Medium" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" Margin="14,0,0,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Targets Selected: "/>
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Run Text=" | Est. Junk: "/>
                            <Run Text="{Binding TotalJunkFormatted, Mode=OneWay}" FontWeight="Bold" Foreground="#38bdf8"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsAnalyzing}" Width="150" Height="5"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
            </Grid>
        </Border>

        <!-- Summary Banner -->
        <Border Grid.Row="2" Margin="0,0,0,8" 
                Background="#064e3b" BorderBrush="#059669" BorderThickness="1" 
                CornerRadius="6" Padding="12,8"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SummaryMessage}" FontWeight="SemiBold" FontSize="13" Foreground="#ecfdf5" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔍 Re-analyze" Command="{Binding AnalyzeCommand}" 
                        Background="#0284c7" Foreground="White" BorderBrush="#38bdf8" BorderThickness="1"
                        FontWeight="Bold" Padding="12,5" FontSize="11" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Target Cards List -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" 
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Category Pill -->
                                    <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                            CornerRadius="4" Padding="8,3" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Size / Status Badge -->
                                    <Border Grid.Column="3" CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1f2937"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BytesFound, Converter={StaticResource ZeroToVis}}" Value="Collapsed">
                                                        <Setter Property="Background" Value="#1e3a5f"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Background" Value="#d97706"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#f3f4f6" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
