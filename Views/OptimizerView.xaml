<UserControl x:Class="WinToolkit.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:OptimizerViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Filter Chip Button Style -->
        <Style x:Key="CategoryChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Impact Tag Style -->
        <Style x:Key="ImpactTagBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Impact}" Value="Recommended">
                    <Setter Property="Background" Value="#14532d"/>
                    <Setter Property="BorderBrush" Value="#16a34a"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="Safe">
                    <Setter Property="Background" Value="#0c4a6e"/>
                    <Setter Property="BorderBrush" Value="#0284c7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImpactTagTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Impact}" Value="Recommended">
                    <Setter Property="Foreground" Value="#86efac"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="Safe">
                    <Setter Property="Foreground" Value="#7dd3fc"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Global Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OS Optimizer &amp; Debloater" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="4" 
                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TargetOsNotice}" FontSize="10" FontWeight="SemiBold" Foreground="#60a5fa"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Segregated by component sections. Fine-tune telemetry, AI Copilot, ads, explorer, latency, and debloat pre-installed apps." 
                           FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Buttons WrapPanel ensuring buttons wrap nicely and never clip -->
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="⭐ Recommended" Command="{Binding SelectRecommendedCommand}" 
                        Background="#6d28d9" Foreground="White" BorderBrush="#a78bfa" BorderThickness="1"
                        FontWeight="Bold" Margin="0,0,5,4" Padding="11,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Background="#1e293b" Foreground="#f8fafc" BorderBrush="#475569" BorderThickness="1"
                        FontWeight="SemiBold" Margin="0,0,5,4" Padding="11,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Clear All" Command="{Binding DeselectAllCommand}" 
                        Background="#1e293b" Foreground="#f8fafc" BorderBrush="#475569" BorderThickness="1"
                        FontWeight="SemiBold" Margin="0,0,6,4" Padding="11,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Expand All" Command="{Binding ExpandAllCommand}" 
                        Background="#1e293b" Foreground="#cbd5e1" BorderBrush="#334155" BorderThickness="1"
                        Margin="0,0,5,4" Padding="10,5" FontSize="11" Cursor="Hand"/>
                <Button Content="Collapse All" Command="{Binding CollapseAllCommand}" 
                        Background="#1e293b" Foreground="#cbd5e1" BorderBrush="#334155" BorderThickness="1"
                        Margin="0,0,8,4" Padding="10,5" FontSize="11" Cursor="Hand"/>
                
                <Button Content="{Binding SelectedCount, StringFormat='⚡ Apply Tweaks ({0})'}" 
                        Command="{Binding ApplySelectedCommand}"
                        Background="#0284c7"
                        Foreground="White"
                        BorderBrush="#38bdf8"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Padding="14,6"
                        FontSize="11"
                        Margin="0,0,5,4"
                        Cursor="Hand"/>

                <Button Content="Revert Selected" Command="{Binding RevertSelectedCommand}" 
                        Background="#334155" Foreground="#f1f5f9" BorderBrush="#64748b" BorderThickness="1"
                        FontWeight="SemiBold" Padding="10,5" FontSize="11" Margin="0,0,0,4" Cursor="Hand"/>
            </WrapPanel>
        </Grid>

        <!-- Search, Safety Banner & Section Filter Chips -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <!-- Top sub-row: Safety Restore Checkbox, Manual Checkpoint, Search Box -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding CreateRestorePointFirst}" 
                              Content="🛡️ Create Windows System Restore Point automatically before applying" 
                              FontWeight="Medium" FontSize="11.5" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="🛡️ Create Checkpoint Now" 
                            Command="{Binding CreateManualRestorePointCommand}" 
                            Background="#0891b2" Foreground="White" BorderBrush="#22d3ee" BorderThickness="1"
                            FontWeight="SemiBold" Margin="14,0,14,0" Padding="10,4" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>

                    <TextBox Grid.Column="2" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center"
                             Padding="8,4"
                             FontSize="11.5"
                             ToolTip="Type to filter tweaks by name or description"/>
                </Grid>

                <!-- Section Navigation Filter Chips Bar -->
                <ItemsControl ItemsSource="{Binding FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CategoryChipButtonStyle}"
                                    Command="{Binding DataContext.SelectCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Background="#20ffffff" CornerRadius="8" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Segregated Section Cards List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding SectionGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Section Group Card -->
                        <Border Margin="0,0,0,14" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8">
                            <StackPanel Orientation="Vertical">
                                <!-- Section Header Banner -->
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        CornerRadius="8,8,0,0" 
                                        Padding="12,8"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Chevron Toggle, Section Icon, Name, Count Badge, Description -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding ToggleExpandedCommand}" 
                                                        Background="Transparent" BorderThickness="0" 
                                                        Padding="4,2" Margin="0,0,6,0" Cursor="Hand"
                                                        ToolTip="Toggle Section Expand/Collapse">
                                                    <TextBlock Text="{Binding ChevronText}" FontSize="11" FontWeight="Bold" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Button>

                                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                                                <!-- Section Selection Status Badge -->
                                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectionBadgeText}" FontSize="10.5" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Section Description Subtitle -->
                                            <TextBlock Text="{Binding Description}" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       Margin="26,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Right: Section Quick Selection Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Select Section" 
                                                    Command="{Binding SelectSectionCommand}" 
                                                    Padding="8,3" FontSize="10.5" Margin="0,0,5,0"
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Cursor="Hand" ToolTip="Select all tweaks in this section"/>

                                            <Button Content="Clear" 
                                                    Command="{Binding ClearSectionCommand}" 
                                                    Padding="8,3" FontSize="10.5" Margin="0,0,5,0"
                                                    Background="Transparent" BorderThickness="1"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Cursor="Hand" ToolTip="Clear selections in this section"/>

                                            <Button Content="{Binding ExpandCollapseButtonText}" 
                                                    Command="{Binding ToggleExpandedCommand}" 
                                                    Padding="6,3" FontSize="10.5"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Tweak Items within this Section -->
                                <ItemsControl ItemsSource="{Binding Tweaks}" 
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                              Margin="10,8,10,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" 
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- CheckBox -->
                                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,10,0"/>

                                                    <!-- Tweak Details: Title, Impact Tag, Description -->
                                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" 
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                                            <!-- Impact Pill -->
                                                            <Border Style="{StaticResource ImpactTagBorderStyle}">
                                                                <TextBlock Text="{Binding Impact}" Style="{StaticResource ImpactTagTextStyle}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                   Margin="0,0,8,0"/>
                                                    </StackPanel>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="2" VerticalAlignment="Center" 
                                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                            CornerRadius="4" Padding="8,3">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
