<UserControl x:Class="WinToolkit.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:OptimizerViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OS Optimizer &amp; Debloater" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="4" 
                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TargetOsNotice}" FontSize="10" FontWeight="SemiBold" Foreground="#60a5fa"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Fine-tune Windows telemetry, performance, background latency, and debloat pre-installed apps." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Buttons WrapPanel ensuring buttons wrap nicely and never clip -->
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⭐ Recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,6,4" Padding="10,5" FontSize="11"/>
                <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,6,4" Padding="10,5" FontSize="11"/>
                <Button Content="Clear" Command="{Binding DeselectAllCommand}" Margin="0,0,8,4" Padding="10,5" FontSize="11"/>
                
                <Button Content="{Binding SelectedCount, StringFormat='⚡ Apply Tweaks ({0})'}" 
                        Command="{Binding ApplySelectedCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="SemiBold"
                        Padding="14,5"
                        FontSize="11"
                        Margin="0,0,6,4"/>

                <Button Content="Revert Selected" Command="{Binding RevertSelectedCommand}" 
                        Padding="10,5" FontSize="11" Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>

        <!-- Safety Banner & Categories -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox IsChecked="{Binding CreateRestorePointFirst}" 
                          Content="🛡️ Create Windows System Restore Point automatically before applying" 
                          FontWeight="Medium" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Create Checkpoint Now" 
                        Command="{Binding CreateManualRestorePointCommand}" 
                        Margin="0,0,12,0" Padding="10,4"/>

                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          Padding="8,4" MinWidth="160"/>
            </Grid>
        </Border>

        <!-- Tweaks List Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Toggle/Checkbox -->
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"/>

                                <!-- Text info -->
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        
                                        <!-- Category Tag -->
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <!-- Impact Tag -->
                                        <Border Background="#1a3d24" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Impact}" FontSize="11" Foreground="#4ade80" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               Margin="0,0,10,0"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2" VerticalAlignment="Center" 
                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                        CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
