<UserControl x:Class="WinToolkit.Views.AdvancedUninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AdvancedUninstallerViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Segmented Tab Navigation Style -->
        <Style x:Key="UninstallerPillTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="PillBorder" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,8" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,15,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Title & Actions -->
            <RowDefinition Height="Auto"/> <!-- Search & Controls Bar -->
            <RowDefinition Height="*"/>    <!-- SubTabs Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Action Buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗑️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Advanced Uninstaller Pro" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Deep software removal with real-time registry and file residue cleanup, Hunter targeting, and browser add-on management." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action Buttons Toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Hunter Mode Trigger -->
                <Button Command="{Binding LaunchHunterModeCommand}"
                        Background="#b91c1c" Foreground="White" BorderBrush="#f87171" BorderThickness="1"
                        FontWeight="Bold" Padding="12,7" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                        ToolTip="Drag target crosshair onto any open window, icon, or tray app to forcibly uninstall it">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎯 " FontSize="12"/>
                        <TextBlock Text="Hunter Mode"/>
                    </StackPanel>
                </Button>

                <!-- Batch Uninstall -->
                <Button Command="{Binding BatchUninstallCommand}"
                        Background="#0369a1" Foreground="White" BorderBrush="#38bdf8" BorderThickness="1"
                        FontWeight="Bold" Padding="12,7" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                        ToolTip="Batch uninstall all selected desktop software applications sequentially">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ " FontSize="12"/>
                        <TextBlock Text="Batch Uninstall"/>
                    </StackPanel>
                </Button>

                <!-- Refresh -->
                <Button Command="{Binding RefreshAllCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="Bold" Padding="12,7" FontSize="11" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " FontSize="12"/>
                        <TextBlock Text="Scan System"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Search & Filter Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8,5" VerticalAlignment="Center" FontSize="12"
                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                <!-- Selection Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="Select All" Command="{Binding SelectAllCurrentCommand}" 
                            FontSize="11" Padding="8,4" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button Content="Clear All" Command="{Binding ClearAllCurrentCommand}" 
                            FontSize="11" Padding="8,4" Margin="0,0,10,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Scan Level Options & Restore Point Toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Create Restore Point" IsChecked="{Binding CreateRestorePoint}" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Scan Mode:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedIndex="{Binding ScanLevel}" Width="110" FontSize="11" Padding="6,3" VerticalAlignment="Center">
                        <ComboBoxItem Content="Safe"/>
                        <ComboBoxItem Content="Moderate"/>
                        <ComboBoxItem Content="Advanced"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: SubTabs Content -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedSubTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- SubTab 0: All Programs -->
            <TabItem Header="📦 All Desktop Programs" Style="{StaticResource UninstallerPillTabItem}">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding FilteredPrograms}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33ffffff"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <!-- Checkbox -->
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>

                            <!-- Program Name -->
                            <DataGridTemplateColumn Header="Program Name" Width="2*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="4,2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding InstallLocation}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Publisher -->
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.5*" IsReadOnly="True"/>

                            <!-- Version -->
                            <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion}" Width="100" IsReadOnly="True"/>

                            <!-- Install Date -->
                            <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate}" Width="95" IsReadOnly="True"/>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="85" IsReadOnly="True"/>

                            <!-- Architecture -->
                            <DataGridTextColumn Header="Arch" Binding="{Binding Architecture}" Width="60" IsReadOnly="True"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2">
                                            <!-- Standard Uninstall with Leftover Scan -->
                                            <Button Content="Uninstall" 
                                                    Command="{Binding DataContext.UninstallSingleProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#dc2626" Foreground="White" BorderBrush="#f87171" BorderThickness="1"
                                                    FontWeight="Bold" FontSize="10.5" Padding="8,4" Margin="0,0,4,0" Cursor="Hand"/>

                                            <!-- Forced Deep Removal -->
                                            <Button Content="Forced Purge" 
                                                    Command="{Binding DataContext.ForcedUninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#7f1d1d" Foreground="#fca5a5" BorderBrush="#b91c1c" BorderThickness="1"
                                                    FontWeight="Bold" FontSize="10.5" Padding="8,4" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- SubTab 1: Windows Apps (Store Apps) -->
            <TabItem Header="📱 Windows Apps (Store)" Style="{StaticResource UninstallerPillTabItem}">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding FilteredWindowsApps}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33ffffff"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            
                            <DataGridTemplateColumn Header="Application Name" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="4,2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PackageFullName}" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Uninstall" 
                                                Command="{Binding DataContext.UninstallUwpAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#dc2626" Foreground="White" BorderBrush="#f87171" BorderThickness="1"
                                                FontWeight="Bold" FontSize="10.5" Padding="8,4" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- SubTab 2: Browser Extensions -->
            <TabItem Header="🧩 Browser Extensions" Style="{StaticResource UninstallerPillTabItem}">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding FilteredExtensions}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33ffffff"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>

                            <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="130" FontWeight="Bold" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Extension Name" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="4,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Extension ID" Binding="{Binding Id}" Width="150" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" 
                                                Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#b91c1c" Foreground="White" BorderBrush="#ef4444" BorderThickness="1"
                                                FontWeight="Bold" FontSize="10.5" Padding="8,4" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- SubTab 3: Leftover Residue Review -->
            <TabItem Header="🧹 Leftover Cleaning Review" Style="{StaticResource UninstallerPillTabItem}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1e293b" BorderBrush="#0284c7" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CurrentAppBeingCleaned, StringFormat='Residual Traces for: {0}'}" 
                                           FontWeight="Bold" FontSize="13" Foreground="#38bdf8"/>
                                <TextBlock Text="Select the residual items you wish to permanently eradicate from files and registry." 
                                           FontSize="11" Foreground="#94a3b8"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔥 Purge Selected Leftovers" Command="{Binding PurgeLeftoversCommand}"
                                    Background="#dc2626" Foreground="White" BorderBrush="#f87171" BorderThickness="1"
                                    FontWeight="Bold" Padding="14,6" FontSize="11" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding Leftovers}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33ffffff"
                                  SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeIcon}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Item Path" Binding="{Binding Path}" Width="3*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="80" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Row 3: Bottom Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsLoading}" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                             Width="120" Height="6" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
