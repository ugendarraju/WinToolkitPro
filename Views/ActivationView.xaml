<UserControl x:Class="WinToolkit.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ActivationViewModel}"
             d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🔑 Windows &amp; Office Activation" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Activate Microsoft Windows and Microsoft Office using the standard Massgrave HWID and Ohook methods in an elevated PowerShell session." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                <!-- Selection Mode Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Choose What to Activate" FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

                        <!-- Option: Both -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                            <RadioButton IsChecked="{Binding IsBothSelected}" GroupName="ActivationTarget"
                                         Command="{Binding SetSelectionCommand}" CommandParameter="Both"
                                         VerticalContentAlignment="Center">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="⚡ Both Windows &amp; Office (Recommended)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Runs `/HWID /Ohook` to generate a permanent digital license for Windows and activate Office suites." 
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Option: Windows Only -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                            <RadioButton IsChecked="{Binding IsWindowsSelected}" GroupName="ActivationTarget"
                                         Command="{Binding SetSelectionCommand}" CommandParameter="Windows"
                                         VerticalContentAlignment="Center">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="🪟 Windows Only (HWID Permanent Digital License)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Runs `/HWID` to bind a genuine permanent digital entitlement to your motherboard hardware." 
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Option: Office Only -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="14,12">
                            <RadioButton IsChecked="{Binding IsOfficeSelected}" GroupName="ActivationTarget"
                                         Command="{Binding SetSelectionCommand}" CommandParameter="Office"
                                         VerticalContentAlignment="Center">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="📑 Microsoft Office Only (Ohook)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Runs `/Ohook` to permanently activate Microsoft Office 365, Office 2024, 2021, 2019, 2016." 
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Button Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="2. Launch Elevated Activation" FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Click the button below to start an elevated Administrator PowerShell prompt with the selected switch." 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <!-- Main Action Button -->
                            <Button Command="{Binding RunActivationCommand}"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Padding="22,10"
                                    Margin="0,0,12,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Run Activation (" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedActivation}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text=")" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Status Message -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️ " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Technical Details Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Execution Command Reference" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="#1e1e2e" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; ([ScriptBlock]::Create((irm https://get.activated.win))) [SWITCHES]&quot;"
                                       FontFamily="Consolas" FontSize="11" Foreground="#a6e3a1" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
