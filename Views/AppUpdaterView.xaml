<UserControl x:Class="WinToolkit.Views.AppUpdaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinToolkit.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AppUpdaterViewModel}"
             d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚀 Update Installed Applications" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Scan and update your installed software to their latest official releases via Windows Package Manager." 
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Prominent Action Buttons Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ScanUpgradesCommand}" Margin="0,0,6,0" Padding="14,7" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 " FontSize="12"/>
                        <TextBlock Text="Check for Updates" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="12,7" FontSize="12"/>
                <Button Content="Clear" Command="{Binding DeselectAllCommand}" Margin="0,0,10,0" Padding="12,7" FontSize="12"/>

                <!-- Primary START UPDATE button -->
                <Button Command="{Binding UpgradeSelectedCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        FontWeight="Bold"
                        Padding="18,7"
                        FontSize="13"
                        Margin="0,0,6,0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ Start Update " FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedUpgradeCount, StringFormat='({0})'}" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Content="Cancel" Command="{Binding CancelUpgradeCommand}" 
                        Visibility="{Binding IsUpgrading, Converter={StaticResource BoolToVis}}"
                        Padding="12,7" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Search & Filter Bar + Status Summary -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalContentAlignment="Center"
                         Padding="10,6"
                         FontSize="12"
                         Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,4"
                            Visibility="{Binding UpgradeCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="Available Updates: "/>
                            <Run Text="{Binding UpgradeCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <Run Text="  |  Selected for Update: "/>
                            <Run Text="{Binding SelectedUpgradeCount, Mode=OneWay}" FontWeight="Bold" Foreground="#10b981"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Upgrades List -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <Grid>
                <!-- Initial / Empty State Prompt -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Visibility="{Binding AllUpgrades.Count, Converter={StaticResource ZeroToVis}}">
                    <TextBlock Text="🔍 Click 'Check for Updates' to scan your installed apps." 
                               FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Queries your installed applications via winget and shows available newer versions." 
                               FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- List of detected updates -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredUpgrades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" 
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Checkbox -->
                                        <CheckBox Grid.Row="0" Grid.Column="0" 
                                                  IsChecked="{Binding IsSelected}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,12,0"/>

                                        <!-- App Details -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                        CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding PackageId}" FontSize="10" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Version Jump Display -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="Installed: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding InstalledVersion}" FontSize="11" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                                
                                                <TextBlock Text="➔  Available: " FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding AvailableVersion}" FontSize="11" FontWeight="Bold" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badges & Quick Action Controls -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Color-coded Status Badge -->
                                            <Border VerticalAlignment="Center" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Background" Value="#166534"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Background" Value="#991b1b"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>

                                            <!-- Quick Retry Button -->
                                            <Button Command="{Binding DataContext.RetryUpgradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRetryInteractive, Converter={StaticResource BoolToVis}}"
                                                    Content="🔄 Retry"
                                                    Padding="8,3" FontSize="11" Margin="0,0,4,0"/>

                                            <!-- Manual / Elevated Console Button -->
                                            <Button Command="{Binding DataContext.RetryInteractiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRetryInteractive, Converter={StaticResource BoolToVis}}"
                                                    Content="🖥️ Manual/UAC"
                                                    ToolTip="Launches elevated installer window in case manual confirmation or custom vendor prompt is needed"
                                                    Padding="8,3" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Per-app progress bar -->
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="0,8,0,0"
                                                     IsIndeterminate="{Binding IsBusy}" 
                                                     Value="{Binding Progress}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Progress and Status Row -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ProgressBar Height="4" Margin="0,4,0,0" Value="{Binding OverallProgress}" 
                             IsIndeterminate="{Binding IsScanning}"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Log Output Console -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Activity &amp; Command Logs" FontSize="11" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
